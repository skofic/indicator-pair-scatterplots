# HTTPS certificates obtained automatically for the addresses. Only the read services of the database are
# exposed; the rest of ArangoDB (its API, its web interface) is not reachable from outside.

# What every site shares: compression, the access log read by fail2ban on the host (repeated refused logins
# ban the address), and the users (users.sh; no file, no login).
(common) {
	encode zstd gzip
	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}
	import /etc/caddy/auth/*.caddy
}

# The data dictionary: its interface (static files served by the database at /web) and its read API (/ui).
# Until DICT_ADDRESS is set in .env the block answers a placeholder name and requests no certificate.
{$DICT_ADDRESS:http://dictionary.invalid} {
	import common
	@dictionary path /_db/metadata/web /_db/metadata/web/* /_db/metadata/ui/*
	handle @dictionary {
		reverse_proxy arangodb:8529
	}
	handle {
		redir / /_db/metadata/web/
		respond 404
	}
}

# The map and the scatterplot.
{$SITE_ADDRESS} {
	import common
	@services path /_db/GeoService/panes/* /_db/metadata/ui/*
	handle @services {
		reverse_proxy arangodb:8529
	}
	handle /_db/* {
		respond 404
	}
	handle {
		root * /srv/site
		redir / /examples/linked.html
		file_server          # honours Range requests: the map files are read by byte ranges
		@maps path /maps/*
		header @maps Cache-Control "public, max-age=604800"
		@pages path /examples/*
		header @pages Cache-Control "no-cache"   # the browser asks each time whether a page changed (a small 304 answer), so a new version shows at once
	}
}
